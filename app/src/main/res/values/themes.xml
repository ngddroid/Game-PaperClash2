<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PaperClash2" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_cream</item>
        <item name="android:colorBackground">@color/paper_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/coral</item>
    </style>

    <!-- Android 12+ system splash: paper cream with the plane-and-star emblem, then our animated splash. -->
    <style name="Theme.PaperClash2.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.PaperClash2</item>
    </style>
</resources>
